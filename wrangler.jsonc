{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "indie-studio-sim",
  "account_id": "46a33dab62fd4f14d46c5322c3fa3cd3",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "indie-studio-sim",
      "database_id": "e613f413-d569-4af2-9710-8c47f58c9e8a"
    }
  ],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
